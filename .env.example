# Environment variable documentation for GEAPI - SISTEMAS
# .env.example

# PORT is set to 3000 by Cloud Run container infrastructure.
PORT=3000

# APP_URL: The public base URL of the application.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_OFICIOS_API_URL: URL do Web App do Google Apps Script publicado para o Controle de Ofícios.
# Exemplo: "https://script.google.com/macros/s/AKfycb.../exec"
VITE_OFICIOS_API_URL=""
